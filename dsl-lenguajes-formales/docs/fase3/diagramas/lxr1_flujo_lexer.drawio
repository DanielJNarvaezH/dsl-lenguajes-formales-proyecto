        <mxCell id="titulo" parent="1" style="text;html=0;fontSize=16;fontStyle=1;align=left;" value="LXR-1 y LXR-2 — Recorrido del AFD con la regla del lexema más largo y manejo de errores léxicos" vertex="1"><mxGeometry x="10" y="-20" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="ini" parent="1" style="ellipse;whiteSpace=wrap;html=0;fontSize=12;" value="Inicio&#xa;posición ← 0, línea ← 1, columna ← 1&#xa;errores ← lista vacía" vertex="1"><mxGeometry x="200" y="25" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="quedan" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;" value="¿posición &lt; longitud&#xa;del texto?" vertex="1"><mxGeometry x="220" y="120" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="eof" parent="1" style="ellipse;whiteSpace=wrap;html=0;fontSize=12;" value="Entregar EOF&#xa;y terminar" vertex="1"><mxGeometry x="560" y="135" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="prep" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=12;" value="q ← q0&#xa;último ← ninguno&#xa;j ← posición" vertex="1"><mxGeometry x="230" y="250" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="trans" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;" value="¿j &lt; longitud y&#xa;δ(q, texto[j])&#xa;no está vacía?" vertex="1"><mxGeometry x="210" y="350" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="mover" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=12;" value="q ← δ(q, texto[j])&#xa;j ← j + 1" vertex="1"><mxGeometry x="230" y="500" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="acep" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;" value="¿q ∈ F?&#xa;(columna token&#xa;no vacía)" vertex="1"><mxGeometry x="230" y="590" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="guardar" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=12;" value="último ← (j, token(q))" vertex="1"><mxGeometry x="10" y="610" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="hubo" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;" value="¿último ≠ ninguno?" vertex="1"><mxGeometry x="540" y="360" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="error" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=12;" value="Error léxico en texto[posición]:&#xa;agregar a errores (símbolo,&#xa;línea, columna); no se entrega token&#xa;fin ← posición + 1" vertex="1"><mxGeometry x="790" y="365" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="lexema" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=12;" value="Retroceder al último estado&#xa;de aceptación:&#xa;lexema ← texto[posición : fin]" vertex="1"><mxGeometry x="530" y="490" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="desc" parent="1" style="rhombus;whiteSpace=wrap;html=0;fontSize=12;" value="¿token es COMENTARIO&#xa;o BLANCO?" vertex="1"><mxGeometry x="540" y="600" width="200" height="100" as="geometry"/></mxCell>
